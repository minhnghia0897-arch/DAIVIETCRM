# Sao chép thành .env.local. Không commit file .env thật.
# Giá trị local lấy từ `pnpm db:start` (supabase status).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng ở server (route handler, Edge Function). Không bao giờ đưa xuống trình duyệt.
SUPABASE_SERVICE_ROLE_KEY=
