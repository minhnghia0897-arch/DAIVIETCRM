# Sao chép thành .env.local. Không commit file .env thật.
# Giá trị local lấy từ `pnpm exec supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chỉ dùng ở server (route handler, server action, Edge Function). Không bao giờ đưa xuống trình duyệt.
SUPABASE_SECRET_KEY=
# Địa chỉ web, dùng để tạo link lời mời.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
